{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "GC-01 Entity",

  "type": "object",

  "required": [
    "id",
    "name"
  ],

  "properties": {

    "id": {
      "type": "string",
      "format": "uuid"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string"
    }

  },

  "additionalProperties": false
}
